# Base local. En el VPS, la del Postgres del mismo host.
DATABASE_URL=postgres://localhost:5432/bitacora

# El token que manda el iPhone en Authorization: Bearer <token>.
# Generá uno de verdad: openssl rand -hex 32
AUTH_TOKEN=cambiame

# Puerto y a qué interfaz atarse. 0.0.0.0 es lo que permite que el teléfono
# llegue por la red local; 127.0.0.1 lo deja sólo para la misma máquina.
PORT=3000
HOST=0.0.0.0

# --- El modelo ---
# Cualquier proveedor compatible con la API de OpenAI.
LLM_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=

# El techo del mes, en dólares. El guard corta ANTES de llamar si ya se pasó.
BUDGET_USD_MES=5

# Precio del modelo, en dólares por millón de tokens. Sin esto el costo
# calculado sería 0 y el techo de arriba no cortaría nunca, así que el proceso
# se niega a arrancar si faltan. Miralos en la página de precios del proveedor.
PRECIO_IN_USD_POR_MTOK=
PRECIO_OUT_USD_POR_MTOK=

# Segundo techo, por cantidad de llamadas. No es redundante: con un tier de
# prueba el precio por token es 0, el techo en dólares no corta nunca y este
# es el único que sigue teniendo dientes.
#
# Cuenta: cada turno de charla es una llamada, más una por día para el resumen
# y una por conversación para la nota de terapia. Con tres charlas de diez
# turnos por día son unas mil al mes.
MAX_LLAMADAS_MES=1500

# Lo que corre solo (resumen del día, notas de terapia) puede ir con un modelo
# más barato que el de la charla. Si falta, es el mismo.
# MODELO_DE_FONDO=

# La clave sale de a dónde apunta LLM_BASE_URL: si es deepinfra.com usa
# DEEPINFRA_API_KEY; si no, OPENAI_API_KEY. Las dos pueden estar a la vez, y
# volver de un proveedor al otro es cambiar la dirección, el modelo y los precios.
#
# Si el proveedor informa cuánto cobró (DeepInfra lo hace), ese número es el que
# se registra y los PRECIO_* de arriba sólo quedan de respaldo.

# --- La memoria larga ---
# Con esta clave, cada resumen de día se guarda también como vector y Bitácora
# recibe los de más atrás que vengan al caso. Sin ella queda apagada y Bitácora
# sigue con los últimos siete días. Necesita la extensión pgvector en Postgres.
# DEEPINFRA_API_KEY=
# MODELO_EMBEDDING=BAAI/bge-m3
# MODELO_RERANK=Qwen/Qwen3-Reranker-4B
# Pasa antes de que Bitácora conteste: corto, y si no llega el turno sale sin eso.
# MEMORIA_TIMEOUT_MS=1500

# Un pedido colgado sin timeout se cuelga para siempre.
LLM_TIMEOUT_MS=60000

# --- El latido ---
# Cada 10 minutos: resume los días que ya terminaron y escribe las notas de
# terapia de sus conversaciones. Corre dentro del proceso del servidor.
#
# LATIDO=off lo apaga: para dispararlo desde un cron con `npm run tick`, o para
# levantar el servidor sin config del LLM (lo que hacen los tests).
# LATIDO=off
# TICK_CADA_MS=600000

# --- La voz de Bitácora ---
# Si está, las respuestas se sintetizan con el mismo proveedor del texto y
# suenan como una persona. Si el servidor no llega, el teléfono usa la voz de
# iOS y sigue: nunca se queda mudo.
#
# Se puede apagar del lado del teléfono, en Ajustes. Acá sólo se configura.
# La voz puede ir con otro proveedor que el texto. Si falta, es el mismo.
# De a dónde apunte salen el modelo, las voces, el formato y el precio:
#   OpenAI     gpt-4o-mini-tts, coral, AAC, ~20 USD por millón de caracteres
#   DeepInfra  inworld-ai/realtime-tts-2, Lupita, WAV, 35 USD
# VOZ_BASE_URL=https://api.deepinfra.com/v1/openai
# MODELO_DE_VOZ=
# El techo de las pausas de la voz, en milisegundos. Más bajo suena más fluido
# y, pasado cierto punto, apurado. En 0 no se tocan. Sólo vale con DeepInfra.
# VOZ_PAUSA_MAX_MS=300
# Hay una sola voz, Lupita. Para otro modelo u otra voz del mismo proveedor
# (en Inworld, castellano: Lupita, Diego, Miguel, Rafael; o el id de una voz
# clonada):
# MODELO_DE_VOZ_MUJER=
# VOZ_MUJER=
# VOZ_TIMEOUT_MS=20000
# Dólares por millón de caracteres. Estimado del tarifario: el proveedor cobra
# por duración de audio y no devuelve `usage`, así que el guard de presupuesto
# lo cuenta por caracteres, que es proporcional.
# PRECIO_VOZ_USD_POR_MCHAR=15
# Qué parte del techo mensual puede comerse la voz, de 0 a 1. La otra parte
# queda para que Bitácora conteste, que es lo que no tiene reemplazo: cuando la voz
# se pasa de su mitad, se apaga sola y el teléfono usa la voz de iOS.
# FRACCION_VOZ=0.5
