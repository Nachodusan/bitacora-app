<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>es_AR</string>
	<key>CFBundleDisplayName</key>
	<string>Bitácora</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>0.1</string>
	<key>CFBundleVersion</key>
	<string>1</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UILaunchScreen</key>
	<dict/>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>

	<key>NSMicrophoneUsageDescription</key>
	<string>Para grabar lo que contás. El audio se transcribe en el teléfono y no se guarda ni se sube.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>La transcripción se hace en el dispositivo, sin conexión. El audio nunca sale del teléfono.</string>

	<!-- Grabación en segundo plano: si la pantalla se bloquea mientras hablás,
	     la transcripción no se corta. -->
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
	</array>

	<!-- ATS. Lo local es para probar en el simulador contra un servidor en la
	     Mac (localhost). La excepción es el servidor de verdad, en el VPS: se
	     llega sólo por Tailscale, que ya cifra todo el camino, y por eso va
	     por http. Esa dirección no es de la red local, y sin nombrarla acá
	     iOS no deja hablarle por http (06/10/2026). -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
		<key>NSExceptionDomains</key>
		<dict>
			<key>localhost</key>
			<dict>
				<key>NSExceptionAllowsInsecureHTTPLoads</key>
				<true/>
			</dict>
		</dict>
	</dict>

	<!-- iOS 14+ pide permiso explícito para hablar con equipos de la red local.
	     Sin esta clave, la primera conexión al Mac falla sin diálogo y sin
	     explicación. Con el servidor en el VPS ya no hace falta, salvo para
	     probar contra la Mac. -->
	<key>NSLocalNetworkUsageDescription</key>
	<string>Para subir tus entradas al servidor de la bitácora corriendo en tu computadora, dentro de tu red.</string>

	<!-- El servidor: el VPS, por Tailscale (06/10/2026). No se cambia desde la
	     app, porque Ajustes ya no tiene ni la dirección ni el token. El token
	     NO va acá, que está versionado: va en Bitacora/Servidor.plist, que git
	     ignora (ver Config.swift y docs/arquitectura.md). -->
	<key>BITACORA_API_URL</key>
	<string>http://localhost:3000</string>
</dict>
</plist>
